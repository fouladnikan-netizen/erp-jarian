VITE_API_BASE_URL=/api/v1
# false = login via real backend JWT; true = mock login (offline UI)
VITE_USE_MOCK_API=false

# Backend (backend/.env). Production MUST set a non-default JWT_SECRET.
# JWT_SECRET=
# NODE_ENV=development
# APP_PUBLIC_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# AI_ROUTES_ENABLED=1

# Playwright E2E (qa:e2e) — QA admin against real Backend+Postgres
# E2E_QA_USERNAME=admin
# E2E_QA_PASSWORD=
