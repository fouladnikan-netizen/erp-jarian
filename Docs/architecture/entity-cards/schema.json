{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaryan.local/architecture/entity-card.schema.json",
  "title": "Jarian Entity Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "tier",
    "status",
    "ownerModule",
    "aggregateRoot",
    "ssot",
    "lifecycle",
    "archivePolicy",
    "auditPolicy",
    "rbacPolicy",
    "databaseTable",
    "apiBasePath",
    "backendRepository",
    "frontendRepository",
    "dependencies",
    "integrationPorts",
    "updatePolicy",
    "ddlRefs"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "tier": { "type": "string", "enum": ["A", "B", "C"] },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "deferred", "superseded"]
    },
    "ownerModule": { "type": "string", "minLength": 1 },
    "aggregateRoot": { "type": "string", "minLength": 1 },
    "ssot": {
      "type": "string",
      "enum": ["postgresql", "client-deferred", "none"]
    },
    "clientState": {
      "type": "string",
      "enum": ["zustand-cache", "react-state", "none"]
    },
    "lifecycle": { "type": "string", "minLength": 1 },
    "archivePolicy": {
      "type": "string",
      "enum": ["soft-delete", "hard-delete", "append-only", "n/a"]
    },
    "auditPolicy": {
      "type": "string",
      "enum": ["append-only", "none"]
    },
    "rbacPolicy": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "databaseTable": { "type": "string" },
    "apiBasePath": { "type": "string" },
    "backendRepository": { "type": "string" },
    "frontendRepository": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrationPorts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updatePolicy": {
      "type": "string",
      "enum": ["SERVER_FIRST", "OPTIMISTIC", "MIXED"]
    },
    "ddlRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DDL-\\d{2}$" },
      "minItems": 1
    },
    "migrationSafety": { "type": "string" },
    "notes": { "type": "string" }
  }
}
