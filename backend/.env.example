# Jarian Backend — copy to backend/.env
PORT=3100
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://ehsanmohammadi@127.0.0.1:5432/jarian

# JWT (change in production)
JWT_SECRET=jarian-dev-secret-change-me
JWT_EXPIRES_IN=12h

# Optional AI rewrite (same as previous src/server)
# OPENAI_API_KEY=
# AI_PROVIDER=mock

# Company identity resolver (Linka) — backend only; never expose to frontend
# Contract verified 2026-08-27: POST /Api/V1/Auth/Login + GET /API/V1/CompanyBaseInfo
# COMPANY_IDENTITY_PROVIDER=mock
# COMPANY_IDENTITY_PROVIDER=linka
# LINKA_BASE_URL=https://api.linka.ir
# LINKA_USERNAME=
# LINKA_PASSWORD=
# LINKA_TIMEOUT_MS=8000
# LINKA_MAX_RETRIES=1
# LINKA_API_KEY=   # deprecated — Login JWT is the production auth; do not use x-key

# Backup / restore (see Docs/architecture/BACKUP_RESTORE.md)
# BACKUP_DIR=/var/backups/jarian
# BACKUP_RETENTION_DAYS=7
# CONFIRM_RESTORE=YES
# TARGET_DATABASE=jarian_restore
